{
  "name": "cytoscape",
  "version": "3.35.0-unstable",
  "license": "MIT",
  "description": "Graph theory (a.k.a. network) library for analysis and visualisation",
  "homepage": "http://js.cytoscape.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/cytoscape/cytoscape.js.git"
  },
  "bugs": {
    "url": "https://github.com/cytoscape/cytoscape.js/issues"
  },
  "keywords": [
    "graph",
    "graph-theory",
    "network",
    "node",
    "edge",
    "vertex",
    "link",
    "analysis",
    "visualisation",
    "visualization",
    "draw",
    "render",
    "biojs",
    "cytoscape"
  ],
  "engines": {
    "node": ">=24"
  },
  "types": "dist/cytoscape.d.ts",
  "main": "dist/cytoscape.cjs.js",
  "module": "dist/cytoscape.esm.mjs",
  "exports": {
    ".": {
      "types": "./dist/cytoscape.d.ts",
      "import": "./dist/cytoscape.esm.mjs",
      "require": "./dist/cytoscape.cjs.js"
    },
    "./dist/cytoscape.esm.mjs": {
      "import": "./dist/cytoscape.esm.mjs"
    },
    "./dist/cytoscape.esm": {
      "import": "./dist/cytoscape.esm.mjs"
    },
    "./dist/cytoscape.esm.min.mjs": {
      "import": "./dist/cytoscape.esm.min.mjs"
    },
    "./dist/cytoscape.esm.min": {
      "import": "./dist/cytoscape.esm.min.mjs"
    },
    "./dist/cytoscape.cjs.js": {
      "require": "./dist/cytoscape.cjs.js"
    },
    "./dist/cytoscape.umd.js": {
      "require": "./dist/cytoscape.umd.js"
    },
    "./dist/cytoscape.min.js": {
      "require": "./dist/cytoscape.min.js"
    },
    "./gpu": {
      "import": "./dist/cytoscape-gpu.esm.mjs"
    }
  },
  "unpkg": "dist/cytoscape.min.js",
  "jsdelivr": "dist/cytoscape.min.js",
  "scripts": {
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit",
    "build:types": "rolldown -c rolldown.dts.config.mjs && node build-dts.mjs",
    "gen:css-types": "node --import tsx scripts/gen-css-types.mjs",
    "test:types": "run-s build:types test:types:run",
    "test:types:run": "tsc -p tsconfig.types-test.json",
    "test:types:docs": "run-s build:types test:types:docs:run",
    "test:types:docs:run": "node test/types-docmaker-surface.mjs",
    "test:types:css": "run-s build:types test:types:css:run",
    "test:types:css:run": "node --import tsx test/types-css-surface.mjs",
    "test:types:exports": "run-s build:types test:types:exports:run",
    "test:types:exports:run": "node test/types-exports.mjs",
    "test:types:compat": "run-s build:types test:types:compat:run",
    "test:types:compat:run": "tsc -p tsconfig.types-compat.json",
    "test:types:fresh": "run-s build:types test:types:fresh:run",
    "test:types:fresh:run": "node --import tsx test/types-generated-fresh.mjs",
    "test:types:all": "run-s build:types test:types:run test:types:docs:run test:types:css:run test:types:exports:run test:types:compat:run test:types:fresh:run",
    "build": "rolldown -c",
    "build:esm": "cross-env FILE=esm rolldown -c",
    "build:esm.min": "cross-env FILE=esm.min rolldown -c",
    "build:cjs": "cross-env FILE=cjs rolldown -c",
    "build:umd": "cross-env FILE=umd rolldown -c",
    "build:min": "cross-env FILE=min rolldown -c",
    "clean": "rimraf build/*",
    "copyright": "node license-update.mjs",
    "dist:copy": "cpy --flat build/cytoscape.umd.js build/cytoscape.min.js build/cytoscape.cjs.js build/cytoscape.esm.mjs build/cytoscape.esm.min.mjs build/cytoscape-gpu.umd.js build/cytoscape-gpu.esm.mjs dist",
    "dist": "cross-env NODE_ENV=production run-s build build:types dist:*",
    "release": "run-s copyright dist docs",
    "watch": "run-s watch:fast",
    "dev": "run-s watch",
    "watch:sync": "livereload \"build, debug, debug/webgl, debug/webgpu\" -w 500 --extraExts 'json'",
    "watch:http": "http-server -p 3333 -s -c -1 -o debug",
    "watch:fast": "run-p watch:sync watch:http watch:build:fast",
    "watch:umd": "run-p watch:sync watch:http watch:build:umd",
    "watch:build:fast": "cross-env FILE=umd SOURCEMAPS=true NODE_ENV=development rolldown -c -w",
    "watch:build:umd": "cross-env FILE=umd SOURCEMAPS=true NODE_ENV=development rolldown -c -w",
    "watch:build:cjs": "cross-env FILE=cjs SOURCEMAPS=true NODE_ENV=development rolldown -c -w",
    "test": "run-s typecheck test:js test:modules test:playwright lint",
    "test:js": "node --import tsx --import ./test/node-test-setup.mjs --test \"test/!(types-*|node-test-setup).mjs\"",
    "test:js:debug": "node --import tsx --import ./test/node-test-setup.mjs --inspect-brk --test --test-concurrency=1 \"test/!(types-*|node-test-setup).mjs\"",
    "test:build": "cross-env TEST_BUILD=true node --import tsx --import ./test/node-test-setup.mjs --test \"test/!(types-*|node-test-setup).mjs\"",
    "test:modules": "node --import tsx --import ./test/node-test-setup.mjs --test \"test/modules/*.mjs\"",
    "test:modules:debug": "node --import tsx --import ./test/node-test-setup.mjs --inspect-brk --test --test-concurrency=1 \"test/modules/*.mjs\"",
    "test:playwright:http": "http-server -p 3333 -s -c -1",
    "test:playwright:build": "cross-env FILE=umd SOURCEMAPS=true NODE_ENV=development rolldown -c",
    "test:playwright:setup": "run-s test:playwright:build test:playwright:http",
    "test:playwright:install": "npx playwright install",
    "test:playwright:run": "playwright test",
    "test:playwright": "run-s test:playwright:install test:playwright:run",
    "docs": "run-s docs:build docs:js",
    "docs:js": "cpy --flat build/cytoscape.min.js documentation/js",
    "docs:build": "node documentation/docmaker.mjs",
    "docs:push": "gh-pages -d documentation",
    "benchmark": "run-s benchmark:all",
    "benchmark:download": "node scripts/download-benchmark.mjs",
    "benchmark:all:exec": "node benchmark/all",
    "benchmark:all": "run-s benchmark:download benchmark:all:exec",
    "benchmark:single:exec": "node benchmark/single",
    "benchmark:single": "run-s benchmark:download benchmark:single:exec",
    "benchmark:gpu": "node --import tsx benchmark/gpu/index.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@rollup/plugin-replace": "^6.0.3",
    "@types/heap": "^0.2.35",
    "@types/lodash": "^4.17.24",
    "@webgpu/types": "^0.1.71",
    "benchmark": "^2.1.4",
    "chai": "^6.2.2",
    "cpy-cli": "^7.0.0",
    "cross-env": "^10.1.0",
    "gh-pages": "^6.3.0",
    "gl-matrix": "^3.4.4",
    "handlebars": "^4.7.6",
    "heap": "^0.2.7",
    "highlight.js": "^11.11.1",
    "http-server": "^14.1.1",
    "livereload": "^0.10.3",
    "lodash": "^4.17.21",
    "marked": "^18.0.6",
    "mitata": "^1.0.34",
    "npm-run-all": "^4.1.5",
    "oxlint": "^1.73.0",
    "rimraf": "^6.1.3",
    "rolldown": "^1.1.5",
    "rolldown-plugin-dts": "^0.27.9",
    "rollup-plugin-license": "^3.5.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "typescript-compiler-api": "npm:typescript@^6.0.3"
  }
}
