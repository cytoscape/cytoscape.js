{
  "name": "cytoscape",
  "version": "4.0.0-unstable",
  "license": "MIT",
  "description": "Graph theory (a.k.a. network) library for analysis and visualisation",
  "homepage": "http://js.cytoscape.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/cytoscape/cytoscape.js.git"
  },
  "bugs": {
    "url": "https://github.com/cytoscape/cytoscape.js/issues"
  },
  "keywords": [
    "graph",
    "graph-theory",
    "network",
    "node",
    "edge",
    "vertex",
    "link",
    "analysis",
    "visualisation",
    "visualization",
    "draw",
    "render",
    "webgpu",
    "gpu",
    "biojs",
    "cytoscape"
  ],
  "engines": {
    "node": ">=24"
  },
  "types": "dist/cytoscape.d.ts",
  "main": "dist/cytoscape.cjs.js",
  "module": "dist/cytoscape.esm.mjs",
  "exports": {
    ".": {
      "types": "./dist/cytoscape.d.ts",
      "import": "./dist/cytoscape.esm.mjs",
      "require": "./dist/cytoscape.cjs.js"
    },
    "./gpu": {
      "types": "./dist/cytoscape.d.ts",
      "import": "./dist/cytoscape.esm.mjs",
      "require": "./dist/cytoscape.cjs.js"
    },
    "./dist/cytoscape.esm.mjs": {
      "import": "./dist/cytoscape.esm.mjs"
    },
    "./dist/cytoscape.esm": {
      "import": "./dist/cytoscape.esm.mjs"
    },
    "./dist/cytoscape.esm.min.mjs": {
      "import": "./dist/cytoscape.esm.min.mjs"
    },
    "./dist/cytoscape.esm.min": {
      "import": "./dist/cytoscape.esm.min.mjs"
    },
    "./dist/cytoscape.cjs.js": {
      "require": "./dist/cytoscape.cjs.js"
    },
    "./dist/cytoscape.umd.js": {
      "require": "./dist/cytoscape.umd.js"
    },
    "./dist/cytoscape.min.js": {
      "require": "./dist/cytoscape.min.js"
    }
  },
  "unpkg": "dist/cytoscape.min.js",
  "jsdelivr": "dist/cytoscape.min.js",
  "scripts": {
    "lint": "oxlint src scripts",
    "lint:quiet": "node scripts/quiet-run.mjs oxlint src scripts",
    "format": "oxfmt src test benchmark scripts debug playwright-tests playwright-page typescript rolldown.config.mjs rolldown.dts.config.mjs playwright.config.js",
    "format:check": "oxfmt --check src test benchmark scripts debug playwright-tests playwright-page typescript rolldown.config.mjs rolldown.dts.config.mjs playwright.config.js",
    "typecheck": "tsc --noEmit",
    "typecheck:quiet": "node scripts/quiet-run.mjs tsc --noEmit",
    "build:types": "rolldown -c rolldown.dts.config.mjs && node scripts/build-dts.mjs",
    "test:types": "run-s build:types test:types:run",
    "test:types:run": "tsc -p tsconfig.types-test.json",
    "test:types:surface": "run-s build:types test:types:surface:run",
    "test:types:surface:run": "node test/types-surface.mjs",
    "test:types:all": "run-s build:types test:types:run test:types:surface:run",
    "build": "rolldown -c",
    "build:quiet": "node scripts/quiet-run.mjs rolldown -c",
    "build:esm": "cross-env FILE=esm rolldown -c",
    "build:esm.min": "cross-env FILE=esm.min rolldown -c",
    "build:cjs": "cross-env FILE=cjs rolldown -c",
    "build:umd": "cross-env FILE=umd rolldown -c",
    "build:min": "cross-env FILE=min rolldown -c",
    "clean": "rimraf build/*",
    "copyright": "node scripts/license-update.mjs",
    "dist:copy": "cpy --flat build/cytoscape.umd.js build/cytoscape.min.js build/cytoscape.cjs.js build/cytoscape.esm.mjs build/cytoscape.esm.min.mjs dist",
    "dist": "cross-env NODE_ENV=production run-s build build:types dist:*",
    "release": "run-s copyright dist",
    "watch": "run-s watch:fast",
    "dev": "run-s watch",
    "watch:sync": "livereload \"build, debug\" -w 500 -b 0.0.0.0 --extraExts 'json'",
    "watch:http": "http-server -p 3333 -s -c -1 -o debug",
    "watch:fast": "run-p watch:sync watch:http watch:build:fast",
    "watch:umd": "run-p watch:sync watch:http watch:build:umd",
    "watch:build:fast": "cross-env FILE=umd SOURCEMAPS=true NODE_ENV=development rolldown -c -w",
    "watch:build:umd": "cross-env FILE=umd SOURCEMAPS=true NODE_ENV=development rolldown -c -w",
    "watch:build:cjs": "cross-env FILE=cjs SOURCEMAPS=true NODE_ENV=development rolldown -c -w",
    "plan:index": "node scripts/plan-index.mjs",
    "verify": "run-s typecheck lint test:js",
    "verify:quiet": "run-s typecheck:quiet lint:quiet test:js:quiet",
    "test": "run-s test:node test:playwright",
    "test:quiet": "run-s test:node:quiet test:playwright:quiet",
    "test:node": "run-s typecheck test:js test:modules test:soak test:throws lint",
    "test:node:quiet": "run-s typecheck:quiet test:js:quiet test:modules:quiet test:soak:quiet test:throws:quiet lint:quiet",
    "test:js": "node --import tsx --import ./test/node-test-setup.mjs --test \"test/!(types-*|node-test-setup|quiet-reporter).mjs\"",
    "test:js:quiet": "node --import tsx --import ./test/node-test-setup.mjs --test --test-reporter=./test/quiet-reporter.mjs \"test/!(types-*|node-test-setup|quiet-reporter).mjs\"",
    "test:js:one": "node --import tsx --import ./test/node-test-setup.mjs --test",
    "test:js:debug": "node --import tsx --import ./test/node-test-setup.mjs --inspect-brk --test --test-concurrency=1 \"test/!(types-*|node-test-setup|quiet-reporter).mjs\"",
    "test:modules": "run-s build test:modules:run",
    "test:modules:quiet": "run-s build:quiet test:modules:run:quiet",
    "test:modules:run": "node --import tsx --import ./test/node-test-setup.mjs --test \"test/modules/*.mjs\"",
    "test:modules:run:quiet": "node --import tsx --import ./test/node-test-setup.mjs --test --test-reporter=./test/quiet-reporter.mjs \"test/modules/*.mjs\"",
    "test:soak": "node --expose-gc --import tsx --import ./test/node-test-setup.mjs --test \"test/soak/*.mjs\"",
    "test:soak:quiet": "node --expose-gc --import tsx --import ./test/node-test-setup.mjs --test --test-reporter=./test/quiet-reporter.mjs \"test/soak/*.mjs\"",
    "test:throws": "node scripts/throw-coverage.mjs",
    "test:throws:quiet": "node scripts/quiet-run.mjs node scripts/throw-coverage.mjs",
    "test:runtimes:node": "run-s build test:runtimes:node:run",
    "test:runtimes:node:run": "node test/runtimes/smoke.mjs",
    "test:runtimes:node:quiet": "run-s build:quiet test:runtimes:node:run:quiet",
    "test:runtimes:node:run:quiet": "node scripts/quiet-run.mjs node test/runtimes/smoke.mjs",
    "test:runtimes:bun": "run-s build test:runtimes:bun:run",
    "test:runtimes:bun:run": "bun test/runtimes/smoke.mjs",
    "test:runtimes:bun:quiet": "run-s build:quiet test:runtimes:bun:run:quiet",
    "test:runtimes:bun:run:quiet": "node scripts/quiet-run.mjs bun test/runtimes/smoke.mjs",
    "test:runtimes:deno": "run-s build test:runtimes:deno:run",
    "test:runtimes:deno:run": "deno run --allow-read test/runtimes/smoke.mjs",
    "test:runtimes:deno:quiet": "run-s build:quiet test:runtimes:deno:run:quiet",
    "test:runtimes:deno:run:quiet": "node scripts/quiet-run.mjs deno run --allow-read test/runtimes/smoke.mjs",
    "docs:api": "node scripts/docs-generate.mjs --out build/docs/api.json",
    "test:modules:debug": "node --import tsx --import ./test/node-test-setup.mjs --inspect-brk --test --test-concurrency=1 \"test/modules/*.mjs\"",
    "test:playwright:http": "http-server -p 3333 -s -c -1",
    "test:playwright:build": "cross-env FILE=umd SOURCEMAPS=true NODE_ENV=development rolldown -c",
    "test:playwright:setup": "run-s test:playwright:build test:playwright:http",
    "test:playwright:install": "npx playwright install",
    "test:playwright:install:quiet": "node scripts/quiet-run.mjs npx playwright install",
    "test:playwright:build:quiet": "node scripts/quiet-run.mjs cross-env FILE=umd SOURCEMAPS=true NODE_ENV=development rolldown -c",
    "test:playwright:run": "playwright test",
    "test:playwright:run:quiet": "playwright test --reporter=./playwright-tests/quiet-reporter.mjs",
    "test:playwright:build:v3": "npm --prefix v3 run build:umd",
    "test:playwright:build:v3:quiet": "node scripts/quiet-run.mjs npm --prefix v3 run build:umd",
    "test:playwright": "run-s test:playwright:install test:playwright:build test:playwright:build:v3 test:playwright:run",
    "test:playwright:quiet": "run-s test:playwright:install:quiet test:playwright:build:quiet test:playwright:build:v3:quiet test:playwright:run:quiet",
    "benchmark": "node --import tsx benchmark/index.mjs",
    "benchmark:report": "node --import tsx benchmark/report.mjs",
    "benchmark:all": "node --import tsx benchmark/report.mjs --all",
    "benchmark:renderer": "node --import tsx benchmark/render-bench.mjs",
    "benchmark:algorithms-gpu": "node --import tsx benchmark/algorithms-gpu-bench.mjs",
    "benchmark:layout-quality": "node benchmark/layout-quality.mjs",
    "benchmark:publish": "node scripts/benchmark-publish.mjs",
    "machine": "node scripts/machine-info.mjs",
    "gpu": "node scripts/gpu-info.mjs",
    "status": "node scripts/status-build.mjs",
    "status:all": "run-s build docs:api status",
    "status:serve": "http-server status -p 3335 -s -c -1 -o"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource/open-sans": "^5.3.0",
    "@playwright/test": "^1.61.1",
    "@rollup/plugin-replace": "^6.0.3",
    "@webgpu/types": "^0.1.71",
    "chai": "^6.2.2",
    "cpy-cli": "^7.0.0",
    "cross-env": "^10.1.0",
    "elkjs": "^0.12.0",
    "highlight.js": "^11.11.1",
    "http-server": "^14.1.1",
    "livereload": "^0.10.3",
    "marked": "^18.0.6",
    "mitata": "^1.0.34",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.73.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "rimraf": "^6.1.3",
    "rolldown": "^1.1.5",
    "rolldown-plugin-dts": "^0.27.9",
    "rollup-plugin-license": "^3.5.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "typescript-compiler-api": "npm:typescript@^6.0.3"
  }
}
