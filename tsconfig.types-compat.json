{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "moduleDetection": "legacy",
    "allowSyntheticDefaultImports": true,
    "allowUmdGlobalAccess": true,
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "skipLibCheck": false,
    "incremental": true,
    "tsBuildInfoFile": "tsconfig.types-compat.tsbuildinfo",
    "types": []
  },
  "include": ["typescript/compat/**/*"]
}
