{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "skipLibCheck": false,
    "incremental": true,
    "tsBuildInfoFile": "tsconfig.types-test.tsbuildinfo",
    "types": []
  },
  "include": ["typescript/tests/**/*.ts"]
}
