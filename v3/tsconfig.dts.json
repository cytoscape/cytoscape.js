{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "stripInternal": true,
    "outDir": "build/types",
    "rootDir": "./src",
    "allowJs": false
  },
  "include": ["src/**/*.mts", "src/**/*.d.ts"]
}
